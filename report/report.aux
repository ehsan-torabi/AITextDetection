\@writefile{toc}{\contentsline {subsection}{\numberline {6.4.3}معماری}{26}{subsection.6.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.2}{\ignorespaces معماری لایهٔ تصمیم سیستم-یک (\en  {JEV}): بدنهٔ مشترک \en  {ParsBERT} و سه سر تصمیم موازی. پیکان نقطه‌چین از معلم \en  {GPT-2} فقط در زمان آموزش (ساخت هدف‌های نرم) برقرار است؛ در زمان سرویس، سه سر خروجی خود را به سیاست سه‌سطحی در لایهٔ برنامه می‌دهند.}}{27}{figure.caption.9}\protected@file@percent }
\newlabel{fig:jev-arch}{{6.2}{27}{معماری لایهٔ تصمیم سیستم-یک (\en {JEV}): بدنهٔ مشترک \en {ParsBERT} و سه سر تصمیم موازی. پیکان نقطه‌چین از معلم \en {GPT-2} فقط در زمان آموزش (ساخت هدف‌های نرم) برقرار است؛ در زمان سرویس، سه سر خروجی خود را به سیاست سه‌سطحی در لایهٔ برنامه می‌دهند}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces درون‌مایهٔ مدل تصمیم \en  {System One} مستقر (آموزش محلی \en  {CPU} در \texttt  {\lr {training/train\_system\_one.py}}): از بدنهٔ \en  {ParsBERT} تنها $4$ لایهٔ پایانی باز می‌ماند؛ جدول \en  {embedding} و لایهٔ \en  {pooler} منجمدند (\en  {pooler} اصلاً فراخوانی نمی‌شود، زیرا مدل \en  {[CLS]} خام را برمی‌دارد) و سه سر تصمیم از صفر مقداردهی و با نرخ یادگیری بزرگ‌تر آموزش می‌بینند. رنگ‌ها همان قرارداد شکل~\ref {fig:transformer-arch} را دارند و پیکان نقطه‌چین معلم تنها در زمان آموزش برقرار است؛ جریان سرویس در شکل~\ref {fig:jev-arch} آمده است.}}{28}{figure.caption.10}\protected@file@percent }
\newlabel{fig:system-one-internals}{{6.3}{28}{درون‌مایهٔ مدل تصمیم \en {System One} مستقر (آموزش محلی \en {CPU} در \texttt {\lr {training/train\_system\_one.py}}): از بدنهٔ \en {ParsBERT} تنها $4$ لایهٔ پایانی باز می‌ماند؛ جدول \en {embedding} و لایهٔ \en {pooler} منجمدند (\en {pooler} اصلاً فراخوانی نمی‌شود، زیرا مدل \en {[CLS]} خام را برمی‌دارد) و سه سر تصمیم از صفر مقداردهی و با نرخ یادگیری بزرگ‌تر آموزش می‌بینند. رنگ‌ها همان قرارداد شکل~\ref {fig:transformer-arch} را دارند و پیکان نقطه‌چین معلم تنها در زمان آموزش برقرار است؛ جریان سرویس در شکل~\ref {fig:jev-arch} آمده است}{figure.caption.10}{}}
