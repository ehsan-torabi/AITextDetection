\@writefile{lof}{\contentsline {figure}{\numberline {آ.1}{\ignorespaces زنجیرهٔ بازتولید: از منابع خام تا آرتیفکت‌های سرویس. چهار آموزش محلی سمت راست مستقل و روی پردازندهٔ مرکزی اجراشدنی‌اند؛ نوت‌بوک یکپارچهٔ \en  {Colab} (پایین چپ) همهٔ مدل‌ها را با \en  {GPU} بازآموزی و قطعه‌ای برای ادغام در \texttt  {\lr {models.json}} تولید می‌کند. پیکان نقطه‌چین «معلم»، مصرف خروجی دسته‌بند \en  {GPT-2} برای ساخت هدف‌های نرم بخش~\ref {sec:jev} است.}}{44}{figure.caption.17}\protected@file@percent }
\newlabel{fig:training-flow}{{آ.1}{44}{زنجیرهٔ بازتولید: از منابع خام تا آرتیفکت‌های سرویس. چهار آموزش محلی سمت راست مستقل و روی پردازندهٔ مرکزی اجراشدنی‌اند؛ نوت‌بوک یکپارچهٔ \en {Colab} (پایین چپ) همهٔ مدل‌ها را با \en {GPU} بازآموزی و قطعه‌ای برای ادغام در \texttt {\lr {models.json}} تولید می‌کند. پیکان نقطه‌چین «معلم»، مصرف خروجی دسته‌بند \en {GPT-2} برای ساخت هدف‌های نرم بخش~\ref {sec:jev} است}{figure.caption.17}{}}
